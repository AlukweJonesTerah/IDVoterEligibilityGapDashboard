# Copy to .env for local or server use.
POSTGRES_DB=icta_dashboard
POSTGRES_USER=icta_dashboard
POSTGRES_PASSWORD=change-me-before-starting

# Exposed for the data team. Keep 0.0.0.0 only where firewall rules allow it.
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_HOST_PORT=15424

# Caddy proxies to the app over caddy_net; this host port is local-only.
APP_HOST_PORT=3094
NEXT_PUBLIC_APP_NAME=ICTA Dashboard

# Required by the app (API routes) and scripts/db-apply.mjs.
# Local compose shape; point at the server database in production.
DATABASE_URL=postgres://icta_dashboard:change-me-before-starting@127.0.0.1:15424/icta_dashboard
