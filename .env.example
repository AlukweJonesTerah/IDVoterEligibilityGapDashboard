# Copy to .env for local or server use.
POSTGRES_DB=icta_dashboard
POSTGRES_USER=icta_dashboard
POSTGRES_PASSWORD=change-me-before-starting

# Exposed for local tooling. Keep 0.0.0.0 only where firewall rules allow it.
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_HOST_PORT=15424

# Caddy proxies to the app over caddy_net; this host port is local-only.
APP_HOST_PORT=3094
NEXT_PUBLIC_APP_NAME=ID & Voter Eligibility Gap Dashboard
# Kept short on purpose: the dataset can change from outside the app (a
# batch reseed, or any other writer against the same database), so both the
# server-side response cache and the browser's poll interval favor
# freshness over long TTLs. See README.md "Refreshing data".
ICTA_API_CACHE_TTL_MS=15000
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=20000

# Required by the app (API routes), scripts/db-apply.mjs, and scripts/seed-eligibility-data.mjs.
#
# The app container reaches Postgres over the compose network at the
# "postgres" service name/port 5432 (below). Host-side tooling (npm run dev,
# the scripts run directly on the host) should instead use
# postgres://icta_dashboard:<password>@127.0.0.1:15424/icta_dashboard --
# .env holds only one value, so pick whichever shape matches how you're
# about to run the app and override on the command line for the other case.
DATABASE_URL=postgres://icta_dashboard:change-me-before-starting@postgres:5432/icta_dashboard

# Alternative: point DATABASE_URL at a hosted Postgres instead of the local
# container (e.g. Neon) -- no code changes needed, this is a drop-in swap.
# Get the connection string from your Neon project (Dashboard > Connect),
# it already includes sslmode=require:
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
